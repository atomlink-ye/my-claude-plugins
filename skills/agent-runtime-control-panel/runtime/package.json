{
  "name": "agent-runtime-control-panel-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/server.ts",
    "test": "pnpm run test:deterministic",
    "test:deterministic": "ARCP_CAMPAIGN_STATE= vitest run ../../../eval/agent-runtime-control-panel/tests/domain ../../../eval/agent-runtime-control-panel/tests/persistence ../../../eval/agent-runtime-control-panel/tests/application ../../../eval/agent-runtime-control-panel/tests/adapters ../../../eval/agent-runtime-control-panel/tests/contracts",
    "test:domain": "ARCP_CAMPAIGN_STATE= vitest run ../../../eval/agent-runtime-control-panel/tests/domain",
    "test:persistence": "ARCP_CAMPAIGN_STATE= vitest run ../../../eval/agent-runtime-control-panel/tests/persistence",
    "test:application": "ARCP_CAMPAIGN_STATE= vitest run ../../../eval/agent-runtime-control-panel/tests/application",
    "test:adapters": "ARCP_CAMPAIGN_STATE= vitest run ../../../eval/agent-runtime-control-panel/tests/adapters",
    "test:contracts": "ARCP_CAMPAIGN_STATE= vitest run ../../../eval/agent-runtime-control-panel/tests/contracts",
    "test:canary": "vitest run ../../../eval/agent-runtime-control-panel/tests/canary"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.1"
  },
  "dependencies": {
    "@getpaseo/client": "0.4.0",
    "@getpaseo/protocol": "0.4.0",
    "ws": "^8.21.3"
  }
}
