#!/usr/bin/env bash
set -euo pipefail
if (( $# != 0 )); then echo "arguments are not accepted; set ARCP_* environment values" >&2; exit 2; fi
: "${PORT:=18787}"
case "$PORT" in (*[!0-9]*|'') echo "PORT must be numeric" >&2; exit 2;; esac
script_dir=$(cd "$(dirname "$0")" && pwd)
skill_root=$(cd "$script_dir/.." && pwd)
server="$skill_root/runtime/dist/server.js"
[[ -f "$server" ]] || { echo "ARCP build is missing; run pnpm --dir '$skill_root/runtime' build" >&2; exit 1; }
state_root="${ARCP_RUNTIME_DIR:-${PASEO_COMPANION_RUNTIME_DIR:-${XDG_STATE_HOME:-${HOME:?HOME is required}/.local/state}/agent-runtime-control-panel}}"
data_dir="${ARCP_DATA:-${PASEO_COMPANION_DATA:-$state_root/data}}"
log_file="${ARCP_LOG:-${PASEO_COMPANION_LOG:-$state_root/arcp.log}}"
pid_file="${ARCP_PID:-${PASEO_COMPANION_PID:-$state_root/arcp.pid}}"
mkdir -p "$state_root" "$data_dir" "$(dirname "$log_file")"
base="http://127.0.0.1:$PORT"
healthy() { curl -fsS --max-time 1 "$base/health" >/dev/null 2>&1; }
runtime() { if [[ -n "${ARCP_API_KEY:-}" ]]; then curl -fsS -H "x-arcp-api-key: $ARCP_API_KEY" "$base/self/runtime"; else curl -fsS "$base/self/runtime"; fi; }
owner_pid() { [[ -f "$pid_file" ]] || return 1; node -e 'const fs=require("fs"); const raw=fs.readFileSync(process.argv[1],"utf8").trim(); const value=raw.startsWith("{")?JSON.parse(raw).pid:raw; if (!/^\d+$/.test(String(value))) process.exit(1); process.stdout.write(String(value));' "$pid_file"; }
adopt_healthy() {
  local observed pid
  observed=$(runtime) || return 1
  pid=$(printf '%s' "$observed" | node -e 'let text="";process.stdin.on("data",x=>text+=x).on("end",()=>{try { const pid=JSON.parse(text).pid; if (!Number.isInteger(pid)||pid<1) process.exit(1); process.stdout.write(String(pid)); } catch { process.exit(1); }});') || { echo "ARCP health responded but runtime identity was invalid" >&2; return 1; }
  printf '{"pid":%s,"port":%s,"dataDir":"%s"}\n' "$pid" "$PORT" "$data_dir" >"$pid_file"
  printf '%s\n' "$observed"
}
if healthy; then adopt_healthy; exit $?; fi
if stale_pid=$(owner_pid 2>/dev/null); then
  if kill -0 "$stale_pid" 2>/dev/null; then
    echo "ARCP owner pid $stale_pid is live but health is unavailable; refusing concurrent start" >&2; exit 1
  fi
  rm -f "$pid_file"
fi
lock="$state_root/start.lock"
if ! mkdir "$lock" 2>/dev/null; then
  for _ in {1..80}; do healthy && { adopt_healthy; exit $?; }; sleep .1; done
  echo "timed out waiting for ARCP startup lock" >&2; exit 1
fi
trap 'rmdir "$lock" 2>/dev/null || true' EXIT
if healthy; then adopt_healthy; exit $?; fi
env -u PASEO_AGENT_ID PORT="$PORT" PASEO_COMPANION_DATA="$data_dir" ARCP_DATA="$data_dir" ARCP_RUNTIME_DIR="$state_root" ARCP_PID="$pid_file" nohup node "$server" >"$log_file" 2>&1 </dev/null &
pid=$!
for _ in {1..80}; do
  if healthy; then adopt_healthy; exit $?; fi
  kill -0 "$pid" 2>/dev/null || { echo "ARCP failed to start; see $log_file" >&2; exit 1; }
  sleep .1
done
echo "ARCP health check timed out; see $log_file" >&2
exit 1
