#!/usr/bin/env node
import { chmod, mkdir, readFile, writeFile } from 'node:fs/promises';
import { dirname, join } from 'node:path';
import { homedir } from 'node:os';
import { spawnSync } from 'node:child_process';
const argv = process.argv.slice(2), area = argv[0], twoWord = ['actor','workspace','task','knowledge','result','member','goal'].includes(area), action = twoWord ? argv[1] : undefined, args = argv.slice(twoWord ? 2 : 1), base = process.env.ARCP_URL || `http://127.0.0.1:${process.env.PORT || 8787}`, admin = process.env.ARCP_API_KEY;
const statePath = process.env.ARCP_CLIENT_STATE || join(process.env.XDG_STATE_HOME || join(homedir(), '.local/state'), 'agent-runtime-control-panel/client.json');
const load = async () => { try { return JSON.parse(await readFile(statePath, 'utf8')); } catch { return {}; } };
const save = async (v) => { await mkdir(dirname(statePath), { recursive: true }); await writeFile(statePath, JSON.stringify(v, null, 2) + '\n', { mode: 0o600 }); await chmod(statePath, 0o600); };
const f = {}, p = []; for (let i=0;i<args.length;i++) { if (args[i].startsWith('--')) { f[args[i].slice(2)] = args[i+1] && !args[i+1].startsWith('--') ? args[++i] : true; } else p.push(args[i]); }
const call = async (method, path, body, memberOnly=false) => { const s = await load(); const h = { ...(!memberOnly && admin ? {'x-arcp-api-key':admin} : {}), ...(!memberOnly && s.actorCredential ? {'x-arcp-actor-key':s.actorCredential} : {}), ...(s.memberCredential ? {'x-arcp-member-key':s.memberCredential} : {}), ...(body ? {'content-type':'application/json'} : {}) }; const r = await fetch(base + path, {method,headers:h,...(body ? {body:JSON.stringify(body)} : {})}); const v = await r.json(); console.log(JSON.stringify(v,null,2)); if (!r.ok) process.exitCode=1; return v; };
if (area === 'ensure') process.exitCode = spawnSync(new URL('./ensure-running', import.meta.url).pathname,{stdio:'inherit',env:process.env}).status ?? 1;
else if (area === 'doctor') await call('GET','/v1/discovery');
else if (area === 'actor' && action === 'register') { const v=await call('POST','/v1/actors',{clientIdentity:p[0],label:f.label,channel:f.channel||'hermes',profileRef:f.profile,conversationRef:f.conversation}); if(v.credential) await save({...await load(),actorCredential:v.credential,actorId:v.actor.id}); }
else if (area === 'workspace' && action === 'create') { const v=await call('POST','/v1/workspaces',{purpose:f.purpose||p.join(' ')}); if(v.id) await save({...await load(),workspaceId:v.id}); }
else if (area === 'workspace' && action === 'join') { const s=await load(); const v=await call('POST',`/v1/workspaces/${encodeURIComponent(p[0])}/join`,{label:f.label||p[1],role:f.role||'worker',capabilities:f.capabilities?.split(',')},Boolean(s.memberCredential)); if(v.credential) await save({...s,memberCredential:v.credential,memberId:v.member.id,workspaceId:v.member.workspaceId}); }
else if (area === 'workspace' && action === 'context') await call('GET',`/v1/workspaces/${encodeURIComponent(p[0])}/context`);
else if (area === 'task' && action === 'create') await call('POST',`/v1/workspaces/${encodeURIComponent(p[0])}/tasks`,{title:f.title||p.slice(1).join(' ')});
else if (area === 'task' && action === 'claim') await call('POST',`/v1/tasks/${encodeURIComponent(p[0])}/claim`,{...(f['expected-fence'] === undefined ? {} : {expectedFence:Number(f['expected-fence'])})},true);
else if (area === 'goal' && action === 'start') { const s=await load(); const g=await call('POST','/v1/goals',{title:f.title||p.join(' ')}); if(g.id) await call('POST','/v1/runtime-sessions',{goalId:g.id,profileId:f.profile||'codex-worker',workspace:f.cwd||process.cwd(),workspaceId:f.workspace||s.workspaceId,memberId:f.member}); }
else if (area === 'start') { const s=await load(); await call('POST','/v1/start',{workspaceId:f.workspace||s.workspaceId,title:f.title||p.join(' '),profileId:f.profile||'codex-worker',paseoWorkspaceRef:f['paseo-workspace']||f.cwd||process.cwd()}); }
else if (area === 'send') await call('POST','/v1/deliveries',{runtimeSessionId:p[0],body:f.body||p.slice(1).join(' '),command:'normal'});
else if (area === 'interrupt') await call('POST','/v1/deliveries',{runtimeSessionId:p[0],body:f.body||p.slice(1).join(' '),command:'interrupt',reason:f.reason});
else if (area === 'knowledge' && action === 'add') await call('POST',`/v1/workspaces/${encodeURIComponent(p[0])}/knowledge`,{kind:f.kind||'learning',text:f.text||p.slice(1).join(' '),tags:f.tags?.split(',')},true);
else if (area === 'result' && action === 'submit') await call('POST',`/v1/workspaces/${encodeURIComponent(p[0])}/results`,{taskId:f.task||p[1],status:f.status||'candidate',summary:f.summary||p.slice(2).join(' '),...(f['expected-fence'] === undefined ? {} : {expectedFence:Number(f['expected-fence'])})},true);
else if (area === 'status') { const s=await load(); await call('GET',`/v1/workspaces/${encodeURIComponent(f.workspace||s.workspaceId)}/context`); }
else if (area === 'reconcile') await call('POST',`/v1/runtime-sessions/${encodeURIComponent(p[0])}/reconcile`);
else if (area === 'ack') await call('POST',`/v1/deliveries/${encodeURIComponent(p[0])}/ack`,{reason:f.reason||p.slice(1).join(' ')||'processed'});
else if (area === 'inbox' || area === 'panorama') { const s=await load(); await call('GET',`/v1/workspaces/${encodeURIComponent(f.workspace||s.workspaceId)}/context`); }
else if (area === 'member' && action === 'heartbeat') { const s=await load(); await call('POST',`/v1/members/${encodeURIComponent(s.memberId)}/heartbeat`,{presence:f.status||'idle'},true); }
else if (area === 'knowledge' && action === 'search') await call('GET',`/v1/workspaces/${encodeURIComponent(p[0])}/knowledge?q=${encodeURIComponent(f.q||'')}&kind=${encodeURIComponent(f.kind||'')}&tag=${encodeURIComponent(f.tag||'')}`);
else if (area === 'canary') { await call('GET','/v1/discovery'); const s=await load(); if (s.workspaceId) await call('GET',`/v1/workspaces/${encodeURIComponent(s.workspaceId)}/context`); }
else { console.error('usage: arcp doctor|ensure|actor register ID|workspace create --purpose X|workspace join WS --label X|workspace context WS|task create WS --title X|task claim TASK --expected-fence N|knowledge add WS --text X|result submit WS --task TASK --summary X --expected-fence N|start --workspace WS --title X --profile P|send RUNTIME --body X|interrupt RUNTIME --reason X --body X|ack DELIVERY|inbox|panorama|member heartbeat|knowledge search WS --q X|status|reconcile SESSION'); process.exitCode=2; }
