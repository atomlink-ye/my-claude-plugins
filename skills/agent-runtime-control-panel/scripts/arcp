#!/usr/bin/env node
import { chmod, mkdir, readFile, writeFile } from 'node:fs/promises';
import { dirname, join } from 'node:path';
import { homedir } from 'node:os';
import { spawnSync } from 'node:child_process';
const argv = process.argv.slice(2), area = argv[0], twoWord = ['actor','workspace','task','knowledge','result','member','goal','runtime','external','reminder','message','child','correction','wakeup','context','idle','ledger','heartbeat','channel','db'].includes(area), action = twoWord ? argv[1] : undefined, args = argv.slice(twoWord ? 2 : 1), base = process.env.ARCP_URL || `http://127.0.0.1:${process.env.PORT || 8787}`, admin = process.env.ARCP_API_KEY;
const HELP = `ARCP ControlWorkspace commands:
  workspace create|join|list|context
  task create|claim|list WORKSPACE [--expected-fence N]
  knowledge add|search|list WORKSPACE
  result submit|list WORKSPACE [--expected-fence N] [--source-id ID]
  channel list WORKSPACE [--kind K] [--state S] [--decision-required]
  channel ack EVENT
  channel resolve EVENT --summary '...' [--verdict accept|refuse]
  channel withdraw DELIVERY
  release DELIVERY [--confirm TOKEN]
  db status|check|backup|export [--kind K] [--since T] | import --from DIR [--db PATH] [--overwrite]
  member heartbeat|list WORKSPACE
  goal start|list
  runtime status|list
  start --workspace WORKSPACE --title '<goal>' [--show-credential]
  external register WORKSPACE [--label LABEL] [--show-credential]
  external status|send|stop|reconcile RUNTIME
  reconcile RUNTIME
  inbox [--workspace WORKSPACE]
  panorama [--workspace WORKSPACE]
  status [--workspace WORKSPACE]
  tui [--workspace WORKSPACE] [--snapshot]
  gate [MANAGER]
  canary

Legacy compatibility commands:
  reminder, message, child, correction, wakeup, idle, compact, heartbeat, ledger
  send, reuse, interrupt, ack, actor, doctor, ensure, preflight

External Runtime note:
  external register creates a sibling Hermes ACP on-call Runtime sharing this ARCP
  Workspace, Knowledge and Delivery surface. It does not attach to the existing
  Feishu Hermes conversation; that Hermes remains Owner and the human entry point.
  Runtime communication is a durable ChannelEvent; completion requires a Result,
  never an idle process.`;
const knownHelpAreas = ['doctor','ensure','preflight','actor','workspace','task','knowledge','result','member','goal','runtime','external','reminder','message','child','correction','wakeup','context','idle','ledger','heartbeat','channel','db','gate','reconcile','inbox','panorama','status','tui','canary','start','send','reuse','interrupt','ack','release'];
const statePath = process.env.ARCP_CLIENT_STATE || join(process.env.XDG_STATE_HOME || join(homedir(), '.local/state'), 'agent-runtime-control-panel/client.json');
const load = async () => { try { return JSON.parse(await readFile(statePath, 'utf8')); } catch { return {}; } };
const save = async (v) => { await mkdir(dirname(statePath), { recursive: true }); await writeFile(statePath, JSON.stringify(v, null, 2) + '\n', { mode: 0o600 }); await chmod(statePath, 0o600); };
const f = {}, p = []; for (let i=0;i<args.length;i++) { if (args[i].startsWith('--')) { f[args[i].slice(2)] = i + 1 < args.length && !args[i+1].startsWith('--') ? args[++i] : true; } else p.push(args[i]); }
const bool = (name) => f[name] === true || f[name] === 'true';
const jsonFlag = (name) => f[name] ? JSON.parse(f[name]) : undefined;
const call = async (method, path, body, memberOnly=false, redactCredential=false) => { const s = await load(); const memberCredential = f.runtime && s.runtimeMemberCredentials?.[f.runtime] ? s.runtimeMemberCredentials[f.runtime] : s.memberCredential; const h = { ...(!memberOnly && admin ? {'x-arcp-api-key':admin} : {}), ...(!memberOnly && s.actorCredential ? {'x-arcp-actor-key':s.actorCredential} : {}), ...(memberCredential ? {'x-arcp-member-key':memberCredential} : {}), ...(body ? {'content-type':'application/json'} : {}) }; const r = await fetch(base + path, {method,headers:h,...(body ? {body:JSON.stringify(body)} : {})}); const v = await r.json(); const output = redactCredential && v?.credential ? (() => { const {credential, ...safe}=v; return {...safe,credentialStored:true}; })() : v; console.log(JSON.stringify(output,null,2)); if (!r.ok) process.exitCode=1; return v; };
const workspaceId = async () => { const s = await load(), value = f.workspace || s.workspaceId; if (!value) { console.error('no workspace selected; run arcp workspace create, arcp workspace join, or pass --workspace WORKSPACE'); process.exitCode = 2; return undefined; } return value; };
const helpFlag = (value) => value === '--help' || value === '-h';
const helpRequested = area === 'help' || area === '--help' || area === '-h' || (knownHelpAreas.includes(area) && (helpFlag(action) || helpFlag(twoWord ? argv[2] : argv[1])));
if (helpRequested || !area) { console.log(HELP); }
else if (area === 'db') {
  try {
    const { SQLiteStateStore, resolveDatabasePath } = await import('../runtime/dist/state-store.js');
    const dbPath = resolveDatabasePath(f.db || process.env.ARCP_DATA || join(process.env.XDG_STATE_HOME || join(homedir(), '.local/state'), 'agent-runtime-control-panel/data'));
    const store = new SQLiteStateStore(dbPath); await store.init();
    if (action === 'status') console.log(JSON.stringify(store.status(), null, 2));
    else if (action === 'check') console.log(JSON.stringify(store.check(), null, 2));
    else if (action === 'backup') { const out = f.out || p[0]; if (!out) throw new Error('db backup requires --out PATH'); console.log(JSON.stringify(await store.backupTo(String(out)), null, 2)); }
    else if (action === 'export') console.log(JSON.stringify(store.export(f.kind ? String(f.kind) : undefined, f.since ? String(f.since) : undefined), null, 2));
    else if (action === 'import') { const source = f.from || p[0]; if (!source) throw new Error('db import requires --from DIR'); console.log(JSON.stringify(await store.importLegacy(String(source), { overwrite: bool('overwrite') }), null, 2)); }
    else { console.error(`unknown db command: ${action || ''}`); process.exitCode = 2; }
    store.close();
  } catch (error) { console.error(error instanceof Error ? error.message : String(error)); process.exitCode = 1; }
}
else {
const launch = () => ({ ...(f.profile ? {profileId:f.profile} : {}), ...(f.provider ? {provider:f.provider} : {}), ...(f.model ? {model:f.model} : {}), ...(f.mode ? {mode:f.mode} : {}), ...(f.thinking ? {thinking:f.thinking} : {}), ...(f.unattended ? {unattended:true} : {}) });
if (area === 'ensure') process.exitCode = spawnSync(new URL('./ensure-running', import.meta.url).pathname,{stdio:'inherit',env:process.env}).status ?? 1;
else if (area === 'doctor') await call('GET','/v1/doctor');
else if (area === 'preflight') await call('POST','/v1/preflight',launch());
else if (area === 'actor' && action === 'register') { const v=await call('POST','/v1/actors',{clientIdentity:p[0],label:f.label,channel:f.channel||'hermes',profileRef:f.profile,conversationRef:f.conversation},false,!f['show-credential']); if(v.credential) await save({...await load(),actorCredential:v.credential,actorId:v.actor.id}); }
else if (area === 'workspace' && action === 'create') { const v=await call('POST','/v1/workspaces',{purpose:f.purpose||p.join(' ')},false,!f['show-credential']); if(v.workspace?.id) await save({...await load(),workspaceId:v.workspace.id,memberId:v.member.id,memberCredential:v.credential}); }
else if (area === 'workspace' && action === 'join') { const s=await load(); const v=await call('POST',`/v1/workspaces/${encodeURIComponent(p[0])}/join`,{label:f.label||p[1],role:f.role||'worker',capabilities:f.capabilities?.split(',')},Boolean(s.memberCredential),!f['show-credential']); if(v.credential) await save({...s,memberCredential:v.credential,memberId:v.member.id,workspaceId:v.member.workspaceId}); }
else if (area === 'workspace' && action === 'context') await call('GET',`/v1/workspaces/${encodeURIComponent(p[0])}/context`);
else if (area === 'external' && action === 'register') { const v=await call('POST','/v1/external',{workspaceId:p[0]||f.workspace,label:f.label,role:f.role,workspace:f.cwd||process.cwd()},false,!f['show-credential']); if(v.credential && v.session?.id) await save({...await load(),runtimeMemberCredentials:{...(await load()).runtimeMemberCredentials||{},[v.session.id]:v.credential}}); }
else if (area === 'external' && action === 'status') await call('GET',`/v1/external/${encodeURIComponent(p[0]||f.runtime)}/status${f.refresh ? '?refresh=1' : ''}`);
else if (area === 'external' && action === 'send') await call('POST',`/v1/external/${encodeURIComponent(p[0]||f.runtime)}/send`,{body:f.body||p.slice(1).join(' '),command:'normal'});
else if (area === 'external' && action === 'stop') await call('POST',`/v1/external/${encodeURIComponent(p[0]||f.runtime)}/stop`);
else if (area === 'external' && action === 'reconcile') await call('POST',`/v1/external/${encodeURIComponent(p[0]||f.runtime)}/reconcile`);
else if (area === 'task' && action === 'create') await call('POST',`/v1/workspaces/${encodeURIComponent(p[0])}/tasks`,{title:f.title||p.slice(1).join(' ')});
else if (area === 'task' && action === 'list') await call('GET',`/v1/workspaces/${encodeURIComponent(p[0])}/tasks`);
else if (area === 'task' && action === 'claim') await call('POST',`/v1/tasks/${encodeURIComponent(p[0])}/claim`,{...(f['expected-fence'] === undefined ? {} : {expectedFence:Number(f['expected-fence'])})},true);
else if (area === 'goal' && action === 'start') { const s=await load(); const g=await call('POST','/v1/goals',{title:f.title||p.join(' '),workspaceId:f.workspace||s.workspaceId}); if(g.id) await call('POST','/v1/runtime-sessions',{goalId:g.id,...launch(),workspace:f.cwd||process.cwd(),workspaceId:f.workspace||s.workspaceId,memberId:f.member}); }
else if (area === 'start') { const s=await load(); const v=await call('POST','/v1/start',{workspaceId:f.workspace||s.workspaceId,title:f.title||p.join(' '),...(f.role?{role:f.role}:{}),...launch(),paseoWorkspaceRef:f['paseo-workspace']||f.cwd||process.cwd()},false,!f['show-credential']); if(v.credential && v.session?.id) await save({...await load(),runtimeMemberCredentials:{...(await load()).runtimeMemberCredentials||{},[v.session.id]:v.credential}}); }
else if (area === 'send') await call('POST','/v1/deliveries',{runtimeSessionId:p[0],body:f.body||p.slice(1).join(' '),command:'normal',cacheConfirmation:f.confirm});
else if (area === 'reuse') await call('POST','/v1/reuse',{runtimeSessionId:p[0],body:f.body||p.slice(1).join(' '),cacheConfirmation:f.confirm});
else if (area === 'interrupt') await call('POST','/v1/deliveries',{runtimeSessionId:p[0],body:f.body||p.slice(1).join(' '),command:'interrupt',reason:f.reason,cacheConfirmation:f.confirm});
else if (area === 'reminder' && action === 'add') await call('POST','/reminders',{agentId:f.agent||p[0],message:f.message||p.slice(1).join(' '),mode:f.mode||'once',...(f['delay-seconds']?{delaySeconds:Number(f['delay-seconds'])}:{}),...(f['every-seconds']?{everySeconds:Number(f['every-seconds'])}:{}),...(f['target-at']?{targetAt:f['target-at']}:{}),...(f['max-runs']?{maxRuns:Number(f['max-runs'])}:{}),...(f.delivery?{delivery:f.delivery}:{}),...(f.urgency?{urgency:f.urgency}:{}),...(f.context?{context:jsonFlag('context')}:{}),...(f['ack-required']!==undefined?{ackRequired:bool('ack-required')}:{}),...(f['subject-child-id']?{subjectChildId:f['subject-child-id']}:{}),...(f.kind?{kind:f.kind}:{}),...(f['watch-kind']?{watchKind:f['watch-kind']}:{}),...(f.name?{name:f.name}:{}),...(f['event-type']?{eventType:f['event-type']}:{}),...(f.criterion?{criterion:f.criterion}:{}),...(f.cron?{cron:f.cron}:{})});
else if (area === 'reminder' && action === 'list') await call('GET',`/reminders${f.agent?`?agentId=${encodeURIComponent(f.agent)}`:''}`);
else if (area === 'reminder' && action === 'get') await call('GET',`/reminders/${encodeURIComponent(p[0])}`);
else if (area === 'reminder' && action === 'delete') await call('DELETE',`/reminders/${encodeURIComponent(p[0])}`,{reason:f.reason||'retired'});
else if (area === 'message' && action === 'send') await call('POST','/messages',{to:f.to||p[0],from:f.from||p[1],body:f.body||p.slice(2).join(' '),...(f.delivery?{delivery:f.delivery}:{}),...(f.mode?{mode:f.mode}:{}),...(f.urgency?{urgency:f.urgency}:{}),...(f.immediate!==undefined?{immediate:bool('immediate')}:{}),...(f['ack-deadline-at']?{ackDeadlineAt:f['ack-deadline-at']}:{}),...(f['ack-deadline-seconds']?{ackDeadlineSeconds:Number(f['ack-deadline-seconds'])}:{}),...(f['reply-to']?{replyTo:f['reply-to']}:{})});
else if (area === 'message' && action === 'list') await call('GET',`/messages?${new URLSearchParams(Object.fromEntries(Object.entries({to:f.to,from:f.from,status:f.status,'replyTo':f['reply-to']}).filter(([,v])=>v))).toString()}`);
else if (area === 'message' && action === 'ack') await call('DELETE',`/messages/${encodeURIComponent(p[0])}`,{reason:f.reason||action});
else if (area === 'message' && action === 'reply') await call('POST','/messages',{to:f.to||p[1],from:f.from||p[2],body:f.body||p.slice(3).join(' '),delivery:f.delivery||'on-idle',mode:'reply',replyTo:p[0]});
else if (area === 'child' && action === 'list') await call('GET',`/children?agentId=${encodeURIComponent(f.agent||p[0])}`);
else if (area === 'child' && action === 'watch') await call('PUT',`/children/${encodeURIComponent(p[0])}?agentId=${encodeURIComponent(f.agent||p[1])}`,{});
else if (area === 'child' && action === 'unwatch') await call('DELETE',`/children/${encodeURIComponent(p[0])}?agentId=${encodeURIComponent(f.agent||p[1])}`,{reason:f.reason||'unwatch'});
else if (area === 'child' && action === 'briefing') await call('GET',`/children/${encodeURIComponent(p[0])}/briefing${f.since?`?since=${encodeURIComponent(f.since)}`:''}`);
else if (area === 'correction' && action === 'open') await call('POST','/corrections',{managerId:f.manager, auditorId:f.auditor, findings:[{text:f.text||p.join(' ')}]});
else if (area === 'correction' && action === 'list') await call('GET','/corrections');
else if (area === 'correction' && action === 'resolve') await call('POST',`/corrections/${encodeURIComponent(p[0])}/resolve`,{findingId:f.finding,verdict:f.verdict,note:f.note});
else if (area === 'gate') await call('GET',`/gate?managerId=${encodeURIComponent(f.manager||p[0])}`);
else if (area === 'wakeup' && action === 'list') await call('GET',`/wakeup-sources?agentId=${encodeURIComponent(f.agent||p[0])}`);
else if (area === 'wakeup' && action === 'add') await call('PUT',`/wakeup-sources/${encodeURIComponent(p[0])}?agentId=${encodeURIComponent(f.agent||p[1])}`,{cadence:f.cadence});
else if (area === 'wakeup' && action === 'delete') await call('DELETE',`/wakeup-sources/${encodeURIComponent(p[0])}?agentId=${encodeURIComponent(f.agent||p[1])}`,{});
else if (area === 'heartbeat' && action === 'list') await call('GET',`/heartbeats${f['include-dead']?'?includeDead=1':''}`);
else if (area === 'heartbeat' && action === 'delete') await call('DELETE',`/heartbeats/${encodeURIComponent(p[0])}`,{reason:f.reason||'retired'});
else if (area === 'context' && action === 'usage') await call('GET',`/context-usage${f.agent?`?agentId=${encodeURIComponent(f.agent)}`:''}`);
else if (area === 'idle' && action === 'add') await call('POST','/idle-reminders',{agentId:f.agent||p[0],message:f.message||p.slice(1).join(' '),...(f['threshold-seconds']?{thresholdSeconds:Number(f['threshold-seconds'])}:{}),...(f['threshold-percent']?{thresholdPercent:Number(f['threshold-percent'])}:{}),...(f['threshold-tokens']?{thresholdTokens:Number(f['threshold-tokens'])}:{}),...(f.metric?{metric:f.metric}:{}),...(f.comparator?{comparator:f.comparator}:{}),...(f.once!==undefined?{once:bool('once')}:{})});
else if (area === 'idle' && action === 'list') await call('GET',`/idle-reminders${f.agent?`?agentId=${encodeURIComponent(f.agent)}`:''}`);
else if (area === 'idle' && action === 'delete') await call('DELETE',`/idle-reminders/${encodeURIComponent(p[0])}`,{reason:f.reason||'retired'});
else if (area === 'ledger' && action === 'add') await call('POST','/ledger',{type:f.type,target:f.target||p[0],verdict:f.verdict,reason:f.reason,recovery:f.recovery});
else if (area === 'ledger' && action === 'list') await call('GET','/ledger');
else if (area === 'ledger' && action === 'revoke') await call('POST',`/ledger/${encodeURIComponent(p[0])}/revoke`,{reason:f.reason});
else if (area === 'compact') await call('POST','/compact-wake',{agentId:f.agent||p[0],compact:f.compact||p.slice(1).join(' '),...(f.wake?{wake:f.wake}:{}),...(f['delay-seconds']?{delaySeconds:Number(f['delay-seconds'])}:{}),...(f['wait-for-idle']!==undefined?{waitForIdle:bool('wait-for-idle')}:{}),...(f['threshold-percent']||f['threshold-tokens']?{trigger:{metric:'context-percent',...(f['threshold-percent']?{thresholdPercent:Number(f['threshold-percent'])}:{}),...(f['threshold-tokens']?{thresholdTokens:Number(f['threshold-tokens'])}:{}),...(f.comparator?{comparator:f.comparator}:{})}}:{})});
else if (area === 'knowledge' && action === 'add') await call('POST',`/v1/workspaces/${encodeURIComponent(p[0])}/knowledge`,{kind:f.kind||'learning',text:f.text||p.slice(1).join(' '),tags:f.tags?.split(',')},true);
else if (area === 'result' && action === 'submit') await call('POST',`/v1/workspaces/${encodeURIComponent(p[0])}/results`,{taskId:f.task||p[1],status:f.status||'candidate',summary:f.summary||p.slice(2).join(' '),...(f['expected-fence'] === undefined ? {} : {expectedFence:Number(f['expected-fence'])}),...(f['source-id'] === undefined ? {} : {sourceId:String(f['source-id'])})},true);
else if (area === 'result' && action === 'list') await call('GET',`/v1/workspaces/${encodeURIComponent(p[0])}/results`);
else if (area === 'channel' && action === 'list') { const workspace=p[0]||await workspaceId(); if(workspace) { const decisionRequired = f['decision-required'] === true || f['decision-required'] === 'true' ? '1' : f['decision-required'] === false || f['decision-required'] === 'false' ? '0' : undefined; await call('GET',`/v1/workspaces/${encodeURIComponent(workspace)}/events?${new URLSearchParams(Object.fromEntries(Object.entries({kind:f.kind,state:f.state,'decision-required':decisionRequired}).filter(([,v])=>v!==undefined))).toString()}`); } }
else if (area === 'channel' && action === 'ack') await call('POST',`/v1/events/${encodeURIComponent(p[0])}/ack`,{reason:f.reason||'acknowledged'});
else if (area === 'channel' && action === 'resolve') await call('POST',`/v1/events/${encodeURIComponent(p[0])}/resolve`,{summary:f.summary||p.slice(1).join(' ')||'Decision resolved',verdict:bool('refuse')?'refuse':(f.verdict?String(f.verdict):'accept')});
else if (area === 'channel' && action === 'withdraw') await call('POST',`/v1/deliveries/${encodeURIComponent(p[0])}/withdraw`,{reason:f.reason||'withdrawn'});
else if (area === 'status') { const workspace=await workspaceId(); if(workspace) await call('GET',`/v1/workspaces/${encodeURIComponent(workspace)}/panorama`); }
else if (area === 'workspace' && action === 'list') await call('GET','/v1/workspaces');
else if (area === 'runtime' && action === 'status') await call('GET',`/v1/runtime-sessions/${encodeURIComponent(p[0])}/status${f.refresh ? '?refresh=1' : ''}`);
else if (area === 'runtime' && action === 'list') await call('GET','/v1/runtime-sessions');
else if (area === 'reconcile') await call('POST',`/v1/runtime-sessions/${encodeURIComponent(p[0])}/reconcile`);
else if (area === 'ack') await call('POST',`/v1/deliveries/${encodeURIComponent(p[0])}/ack`,{reason:f.reason||p.slice(1).join(' ')||'processed',...(f.generation?{generation:Number(f.generation)}:{})});
else if (area === 'release') await call('POST',`/v1/deliveries/${encodeURIComponent(p[0])}/release`,{...(f.confirm?{confirmation:f.confirm}:{})});
else if (area === 'inbox') { const workspace=await workspaceId(); if(workspace) await call('GET',`/v1/workspaces/${encodeURIComponent(workspace)}/context`); }
else if (area === 'panorama') { const workspace=await workspaceId(); if(workspace) await call('GET',`/v1/workspaces/${encodeURIComponent(workspace)}/panorama${f.refresh ? '?refresh=1' : ''}`); }
else if (area === 'tui') { const workspace=await workspaceId(); if(workspace) { const s=await load(), headers={...(admin?{'x-arcp-api-key':admin}:{}),...(s.actorCredential?{'x-arcp-actor-key':s.actorCredential}:{}),...(s.memberCredential?{'x-arcp-member-key':s.memberCredential}:{})}, fetchPanorama=async(refresh=false)=>{const r=await fetch(`${base}/v1/workspaces/${encodeURIComponent(workspace)}/panorama${refresh?'?refresh=1':''}`,{headers}); const v=await r.json(); if(!r.ok) throw new Error(v.message||v.code||'panorama failed'); return v;}, tui=await import('../runtime/dist/tui.js'); if(f.snapshot){try{console.log(tui.renderTuiSnapshot(await fetchPanorama(false)));}catch(error){console.log(JSON.stringify({code:error instanceof Error?error.message:String(error)},null,2));process.exitCode=1;}} else await tui.runTui({fetchPanorama}); } }
else if (area === 'member' && action === 'heartbeat') { const s=await load(); await call('POST',`/v1/members/${encodeURIComponent(s.memberId)}/heartbeat`,{presence:f.status||'idle'},true); }
else if (area === 'member' && action === 'list') await call('GET',`/v1/workspaces/${encodeURIComponent(p[0])}/members`);
else if (area === 'goal' && action === 'list') await call('GET','/v1/goals');
else if (area === 'knowledge' && action === 'search') await call('GET',`/v1/workspaces/${encodeURIComponent(p[0])}/knowledge?q=${encodeURIComponent(f.q ?? '')}&kind=${encodeURIComponent(f.kind||'')}&tag=${encodeURIComponent(f.tag||'')}`);
else if (area === 'knowledge' && action === 'list') await call('GET',`/v1/workspaces/${encodeURIComponent(p[0])}/knowledge?q=&kind=&tag=`);
else if (area === 'canary') { await call('GET','/v1/discovery'); const s=await load(); if (s.workspaceId) await call('GET',`/v1/workspaces/${encodeURIComponent(s.workspaceId)}/context`); }
else { console.error(`unknown command: ${twoWord && action ? action : area}\n\n${HELP}`); process.exitCode=2; }
}
