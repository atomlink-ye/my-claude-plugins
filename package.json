{
  "name": "my-claude-plugins",
  "version": "0.1.0",
  "description": "Personal Claude Code plugin marketplace.",
  "type": "module",
  "scripts": {
    "test": "pnpm run test:js && pnpm run test:python",
    "test:js": "vitest run",
    "test:python": "python3 -m unittest discover -s eval/skill-creator/tests -p 'test_*.py'",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.1.1",
    "vitest": "^3.1.1"
  },
  "dependencies": {
    "@daytona/sdk": "^0.169.0"
  }
}
